{
  "name": "interview-kit",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "bin": {
    "interview-kit": "bin/interview-kit.js"
  },
  "exports": {},
  "scripts": {
    "prepare": "[ ! -e .git ] || git config core.hooksPath .githooks",
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "vite build",
    "test": "KIT_PACK=sample-pack vitest run",
    "test:platform": "playwright install firefox webkit && IK_PLATFORM=1 KIT_PACK=sample-pack vitest run test/platform",
    "dev:sync": "VITE_SYNC=1 vite --port 5181",
    "build:sync": "VITE_SYNC=1 vite build --outDir dist-sync",
    "a11y": "vite build && node scripts/a11y.mjs",
    "clip": "vite build && node scripts/clip-audit.mjs",
    "verify": "npm test && npm run a11y && node scripts/clip-audit.mjs",
    "capture": "node capture/run.mjs",
    "capture:check": "node capture/run.mjs --check",
    "review:pending": "node scripts/review-pending.mjs",
    "suggest": "node scripts/suggest-pools.mjs",
    "suggest:eval": "node scripts/suggest-eval.mjs"
  },
  "dependencies": {
    "marked": "18.0.14",
    "open-props": "1.7.23",
    "shiki": "4.5.0",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@typesafe-ai/sdk": "0.6.0",
    "eslint": "9.39.1",
    "happy-dom": "20.14.6",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22"
  }
}
