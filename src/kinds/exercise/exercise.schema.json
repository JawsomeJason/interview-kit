{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ik:exercise",
  "title": "An exercise: exercises/<id>/exercise.md, after lowering. Findings are its Look for list.",
  "type": "object",
  "required": ["id", "name", "minutes", "brief", "lookFor"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "ik:common#/$defs/id" },
    "name": { "$ref": "ik:common#/$defs/text" },
    "minutes": { "type": "integer", "minimum": 0, "maximum": 180 },
    "competencies": { "$ref": "ik:common#/$defs/ids", "description": "Default for findings with no #tag." },
    "brief": { "$ref": "ik:common#/$defs/text" },
    "paste": { "$ref": "ik:common#/$defs/text" },
    "run": { "$ref": "ik:common#/$defs/text" },
    "fallback": { "$ref": "ik:common#/$defs/text" },
    "lookFor": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "ik:common#/$defs/observable" } },
    "stretch": { "type": "array", "maxItems": 12, "items": { "$ref": "ik:common#/$defs/levelText" } }
  }
}
