{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ik:script",
  "title": "A script: scripts/<id>.md, after lowering",
  "type": "object",
  "required": ["id", "name", "minutes", "blocks"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "ik:common#/$defs/id" },
    "name": { "$ref": "ik:common#/$defs/text" },
    "minutes": { "type": "integer", "minimum": 0, "maximum": 180 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "md"],
        "additionalProperties": false,
        "properties": {
          "title": { "$ref": "ik:common#/$defs/text" },
          "md": { "$ref": "ik:common#/$defs/text" },
          "copy": { "type": "boolean", "description": "True for 'Paste to the candidate': the screen adds a Copy button." }
        }
      }
    },
    "lookFor": { "type": "array", "items": { "$ref": "ik:common#/$defs/observable" } }
  }
}
