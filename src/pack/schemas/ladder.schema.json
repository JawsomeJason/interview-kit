{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ik:ladder",
  "title": "ladder.md, after lowering: every ## heading is a level, lowest first. {#id} is optional and defaults to the name slugged.",
  "type": "object",
  "required": ["levels"],
  "additionalProperties": false,
  "properties": {
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "ik:common#/$defs/id" },
          "name": { "$ref": "ik:common#/$defs/text" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
