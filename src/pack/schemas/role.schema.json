{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ik:role",
  "title": "A role: roles/<id>.md, after lowering",
  "type": "object",
  "required": [
    "id",
    "name",
    "hiring",
    "rounds",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "ik:common#/$defs/id"
    },
    "name": {
      "$ref": "ik:common#/$defs/text"
    },
    "hiring": {
      "$ref": "ik:common#/$defs/id",
      "description": "A level id from ladder.md. The one level that drives every card's view."
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "ik:common#/$defs/id"
      }
    },
    "competencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "ik:common#/$defs/id"
      },
      "description": "Which competencies this role gathers evidence on, in display order. Absent means all."
    },
    "about": {
      "type": "string"
    },
    "decisions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "means"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "ik:common#/$defs/id"
          },
          "label": {
            "$ref": "ik:common#/$defs/text"
          },
          "means": {
            "$ref": "ik:common#/$defs/text"
          }
        }
      }
    }
  }
}
