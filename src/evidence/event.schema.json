{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ik:event",
  "title": "One event in an interviewer's log. Public types live on the pub stream, private types on the prv stream, and a shared value has one fixed type per key, so nothing here can carry a score.",
  "$defs": {
    "n": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Position in this author's stream for the event's channel, gap-free from 0." },
    "h": { "type": "string", "pattern": "^[0-9a-f]{12}\\.[0-9a-f]{4}$", "description": "Hybrid logical clock: wall milliseconds, then a counter." },
    "ref": { "type": "string", "minLength": 1, "maxLength": 200 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "segment": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$", "description": "<round id>/<segment id>." },
    "pub": {
      "description": "Plan facts. Synced live to every admitted member.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "v", "sid", "author", "role", "round", "pack"],
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "open" }, "v": { "const": 2 },
            "sid": { "$ref": "#/$defs/ref" }, "author": { "$ref": "#/$defs/ref" }, "role": { "$ref": "#/$defs/id" }, "round": { "$ref": "#/$defs/id" },
            "pack": { "type": "object", "additionalProperties": false, "required": ["id", "version", "sha"], "properties": { "id": { "$ref": "#/$defs/ref" }, "version": { "type": "string", "maxLength": 40 }, "sha": { "type": "string", "maxLength": 64 } } } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "name"],
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "name" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "k", "v"], "description": "Register: the candidate's name.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "put" }, "k": { "const": "session.candidate" }, "v": { "type": "string", "maxLength": 120 } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "k", "v"], "description": "Register: when the interview clock started, wall milliseconds as 12 hex digits.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "put" }, "k": { "const": "session.startedAt" }, "v": { "type": "string", "pattern": "^[0-9a-f]{12}$" } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "k", "v"], "description": "Register: the minutes the interview was planned to take, from the start page.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "put" }, "k": { "const": "session.length" }, "v": { "type": "integer", "minimum": 0, "maximum": 600 } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "k", "seg", "v"], "description": "Register: a segment's length in minutes.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "put" }, "k": { "const": "segment.minutes" }, "seg": { "$ref": "#/$defs/segment" }, "v": { "type": "integer", "minimum": 0, "maximum": 180 } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "k", "seg", "v"], "description": "Register: the segment's fallback switch.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "put" }, "k": { "const": "segment.fallback" }, "seg": { "$ref": "#/$defs/segment" }, "v": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "k", "id", "v"], "description": "Set member: a passion the candidate named. id is a pool id or x-<slug> for free text; v is its label, or null to untick.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "member" }, "k": { "const": "session.passions" }, "id": { "$ref": "#/$defs/id" }, "v": { "type": ["string", "null"], "minLength": 1, "maxLength": 60 } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "k", "seg", "id", "v"], "description": "Set member: a pool picked for a questions segment (pick order is add order), or a card opened there. true adds, null removes.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "member" }, "k": { "enum": ["segment.pools", "segment.asked"] }, "seg": { "$ref": "#/$defs/segment" }, "id": { "$ref": "#/$defs/id" }, "v": { "enum": [true, null] } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t"], "description": "This author has decided. No content.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "decided" } } }
      ]
    },
    "prv": {
      "description": "Judgment. Stays on the author's laptop until both sides have decided.",
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "o", "d", "s"], "description": "A mark. The press toggles seen and clear; not seen is its own gesture. 'After a nudge' is never written: it is a given prompt logged before the seen mark.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "mark" }, "o": { "$ref": "#/$defs/ref" }, "d": { "type": "string", "pattern": "^[0-9a-f]{8}$", "description": "Digest of the observable's text when marked." }, "s": { "enum": ["seen", "unseen", "clear"] } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "p"], "description": "A nudge given or a stretch prompt asked, by an explicit press. given: false takes it back.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "prompt" }, "p": { "$ref": "#/$defs/ref" }, "given": { "type": "boolean", "default": true } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "scope", "text"], "description": "The note's whole latest text, written on blur or after 2 s idle. The latest per scope wins.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "note" }, "scope": { "$ref": "#/$defs/ref" }, "text": { "type": "string", "maxLength": 8000 } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "item", "closed"],
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "close" }, "item": { "$ref": "#/$defs/ref" }, "closed": { "type": "boolean" } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "level"], "description": "This interviewer's Evaluating at level. Changes only their own layers.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "focus" }, "level": { "$ref": "#/$defs/id" } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "choice", "why"], "description": "The first is the blind decision; later ones are amendments.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "decide" }, "choice": { "$ref": "#/$defs/id" }, "level": { "$ref": "#/$defs/id" }, "why": { "type": "string", "maxLength": 4000 } } },
        { "type": "object", "additionalProperties": false, "required": ["n", "h", "t", "from"], "description": "When I first saw that colleague's evidence.",
          "properties": { "n": { "$ref": "#/$defs/n" }, "h": { "$ref": "#/$defs/h" }, "t": { "const": "peek" }, "from": { "$ref": "#/$defs/ref" } } }
      ]
    }
  },
  "oneOf": [{ "$ref": "#/$defs/pub" }, { "$ref": "#/$defs/prv" }]
}
